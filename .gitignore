# In: .gitignore

# ----------------------------------------------------------------
# General Project Ignores
# ----------------------------------------------------------------

# Environment variables files - DO NOT COMMIT SENSITIVE DATA
.env
.env.*
!.env.example

# Log files
*.log
logs
*.log.*

# Dependency directories
node_modules/

# Build output directories
dist/
build/
out/

# IDE and editor specific files
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS generated files
.DS_Store
Thumbs.db

# ----------------------------------------------------------------
# pnpm Specific
# ----------------------------------------------------------------
pnpm-lock.yaml
pnpm-debug.log

# ----------------------------------------------------------------
# Frontend Specific (React / Vite)
# ----------------------------------------------------------------

# Vite cache
apps/frontend/.vite/
apps/admin-panel/.vite/

# Local build output (should already be covered by global 'dist/')
apps/frontend/dist/
apps/admin-panel/dist/

# Test reports
coverage/

# ----------------------------------------------------------------
# Go Specific (api-go)
# ----------------------------------------------------------------

# Compiled binary files
apps/api-go/server
apps/api-go/*.exe
apps/api-go/*.exe~
apps/api-go/*.dll
apps/api-go/*.so
apps/api-go/*.dylib

# ----------------------------------------------------------------
# Python Specific (api-python)
# ----------------------------------------------------------------

# Python cache files
__pycache__/
*.py[cod]
*$py.class

# Virtual environment
.venv/
venv/
ENV/
env.bak/
env/

# Distribution / packaging
.Python
/build/
/develop-eggs/
/dist/
/downloads/
/eggs/
.eggs/
/lib/
/lib64/
/parts/
/sdist/
/var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Mypy cache
.mypy_cache/

# pytest cache
.pytest_cache/

# ----------------------------------------------------------------
# Docker Specific
# ----------------------------------------------------------------

# Local docker-compose override files
docker-compose.override.yml
docker-compose.local.yml

# Docker volumes (if mapped locally for debugging)
medlead_db_data/